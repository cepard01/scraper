{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@brique/core": ["./packages/core/src/types.ts"],
      "@brique/core/*": ["./packages/core/src/*"],
      "@brique/scrapers": ["./packages/scrapers/src/index.ts"],
      "@brique/scrapers/*": ["./packages/scrapers/src/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
